DOCKERHUB_USERNAME=yourdockerhubuser
TAG=v3.0
JWT_KEY=replace-with-a-long-random-secret-of-at-least-32-characters
ADMIN_EMAIL=admin@coffeenchill.ac.za
ADMIN_PASSWORD=Admin@12345
SIMULATE_LIFECYCLE=true
# Required for staff-docs (Azure File Share) - Azurite does not emulate Azure Files
FILES_CONNECTION=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# Optional: point at a real Azure Storage account instead of Azurite
# STORAGE_CONNECTION=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
